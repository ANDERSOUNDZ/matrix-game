# Plantilla de configuracion (ver GUIA-ARQUITECTURA-Y-CALIDAD.md seccion 0.5).
# Copiar como ".env" para desarrollo local. En produccion estos valores se
# inyectan como variables de entorno reales, nunca commiteados.

# --- Backend ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
JWT_SECRET=cambiar-esto-en-produccion

# --- Base de datos ---
# Una sola instancia de Postgres compartida; cada modulo usa su propio
# esquema dentro de la misma base (ver seccion "Independencia de la base
# de datos" del plan/README).
POSTGRES_DB=matrix_game
POSTGRES_USER=matrix_game
POSTGRES_PASSWORD=cambiar-esto-en-produccion
DATABASE_URL=postgresql://matrix_game:cambiar-esto-en-produccion@postgres:5432/matrix_game

# --- Frontend ---
FRONTEND_PORT=8080
